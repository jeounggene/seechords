.DS_Store
.venv/
.cursor/
.claude/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.env
.env.local

# Trained sklearn / RF models (often 100MB+; use Releases or external storage)
training/models/*.pkl

# Regenerated feature caches (run prepare_data to rebuild)
training/data/*.npz

# Audio datasets (often GBs; keep local only — not for GitHub)
training/data/**/*.wav
training/data/**/audio/
training/data/**/*.mp3
