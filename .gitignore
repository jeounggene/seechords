.DS_Store
.venv/
.cursor/    
.claude/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
.env
.env.local

# Trained sklearn / RF models (often 100MB+; use Releases or external storage)
training/models/*.pkl

# Regenerated feature caches (run prepare_data to rebuild)
training/data/*.npz

# BTC model checkpoints (downloaded from ChordMini, too large for git)
server/btc_model/*.pt
server/btc_model/*.pth

# Training model checkpoints (large; use Releases or external storage)
training/models/*.pt

# Audio files (not redistributable)
training/data/*/audio/

# Uploaded audio (ephemeral)
server/uploads/*.m4a
server/uploads/*.mp3
server/uploads/*.wav
server/uploads/wav_cache/

# Training logs (reproducible from training scripts)
training/logs/*.log

# yt-dlp Netscape cookies (set YTDLP_COOKIEFILE; never commit real sessions)
yt_cookies.txt
**/yt_cookies.txt
# Local browser exports (never commit)
cookies.txt
cookies-youtube.txt

# Chrome extension zip (regenerate locally for store upload)
dist/
